root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

[*.{c,cpp,h,hpp}]
indent_style = space
indent_size = 2

[{CMakeLists.txt,*.cmake,*.cmake.in}]
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
